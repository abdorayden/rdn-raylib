"../nativelibs/rdnraylib.so" loadnative

"Typecheck" load
"Core" load

Typecheck::OGTypes open

RdnRaylib module


    ( 200 200 200 255 ) LIGHTGRAY  const
    ( 130 130 130 255 ) GRAY       const
    ( 80 80 80 255 ) DARKGRAY   const
    ( 253 249 0 255 ) YELLOW     const
    ( 255 203 0 255 ) GOLD       const
    ( 255 161 0 255 ) ORANGE     const
    ( 255 109 194 255 ) PINK       const
    ( 230 41 55 255 ) RED        const
    ( 190 33 55 255 ) MAROON     const
    ( 0 228 48 255 ) GREEN      const
    ( 0 158 47 255 ) LIME       const
    ( 0 117 44 255 ) DARKGREEN  const
    ( 102 191 255 255 ) SKYBLUE    const
    ( 0 121 241 255 ) BLUE       const
    ( 0 82 172 255 ) DARKBLUE   const
    ( 200 122 255 255 ) PURPLE     const
    ( 135 60 190 255 ) VIOLET     const
    ( 112 31 126 255 ) DARKPURPLE const
    ( 211 176 131 255 ) BEIGE      const
    ( 127 106 79 255 ) BROWN      const
    ( 76 63 47 255 ) DARKBROWN  const

    ( 255 255 255 255 ) WHITE      
    ( 0 0 0 255 ) BLACK      
    ( 0 0 0 0 ) BLANK      
    ( 255 0 255 255 ) MAGENTA    
    ( 245 245 245 255 ) RAYWHITE   


    ConfigFlags module

        0x00000040 VsyncHint const
        0x00000002 FullscreenMode const 
        0x00000004 WindowResizable const
        0x00000008 WindowUndecorated const 
        0x00000080 WindowHidden      const 
        0x00000200 WindowMinimized   const 
        0x00000400 WindowMaximized   const 
        0x00000800 WindowUnfocused   const 
        0x00001000 WindowTopmost     const 
        0x00000100 WindowAlways_run  const 
        0x00000010 WindowTransparent const 
        0x00002000 WindowHighdpi     const 
        0x00004000 WindowMousePassthrough const
        0x00008000 BorderlessWindowedMode const
        0x00000020 Msaa4xHint       const
        0x00010000 InterlacedHint    const

    end

    RlTypes module
        Any Color const
        Int ConfigFlag const
        Int VoidPtr const
        List Vector2 const
    end

    [* private *]
    Helpers module
        colors-slice-to-int apply
            ma-list let
            ma-list 0 index 24 <<
            ma-list 1 index 16 << 
            +
            ma-list 2 index 8 <<
            ma-list 3 index
            +
            +

        end

        all-ints apply
            ma-list let
            ma-list 0 index Core::@is_int?
            ma-list 1 index Core::@is_int? 
            &
            ma-list 2 index Core::@is_int?
            ma-list 3 index Core::@is_int? 
            &
            &
        end

        check-colors apply
            dup
            Core::@is_list? if
                dup
                len 4 = if
                    dup
                    RdnRaylib::Helpers::all-ints
                    if
                        dup
                        RdnRaylib::Helpers::colors-slice-to-int
                    end
                end
            else
                dup
                Core::@is_int? ! if
                    "value is not type of Color" error
                    1 exit
                end
            end
        end

    end

    init-window (Int Int Str) () defun
        rdn_init_window call
    end

    close-window () () defun
        rdn_close_window call
    end

    begin-drawing () () defun
        rdn_begin_drawing call
    end

    end-drawing () () defun
        rdn_end_drawing call
    end

    window-should-close () (Bool) defun
        rdn_window_should_close call
    end

    clear-background (RdnRaylib::RlTypes::Color) () defun
        RdnRaylib::Helpers::check-colors
        rdn_clear_background call
    end

    draw-rectangle (Int Int Int Int RdnRaylib::RlTypes::Color) () defun
        RdnRaylib::Helpers::check-colors
        rdn_draw_rectangle call
    end

