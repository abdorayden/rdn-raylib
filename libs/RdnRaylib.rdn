        enum MIDDLE_RIGHT const         [*Gamepad center buttons, right one (i.e. PS3: Start)*]
        enum LEFT_THUMB const           [*Gamepad joystick pressed button left*]
        enum RIGHT_THUMB const          [*Gamepad joystick pressed button right*]
        reset
    end

