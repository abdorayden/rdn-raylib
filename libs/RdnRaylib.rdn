    [* private *]
    Helpers module
        colors-slice-to-int apply
            ma-list let
            ma-list 0 index 24 <<
            ma-list 1 index 16 << 
            +
            ma-list 2 index 8 <<
            ma-list 3 index
            +
            +

        end

        all-ints apply
            ma-list let
            ma-list 0 index Core::@is_int?
            ma-list 1 index Core::@is_int? 
            &
            ma-list 2 index Core::@is_int?
            ma-list 3 index Core::@is_int? 
            &
            &
        end

        check-colors apply
            dup
            Core::@is_list? if
                dup
                len 4 = if
                    dup
                    RdnRaylib::Helpers::all-ints
                    if
                        dup
                        RdnRaylib::Helpers::colors-slice-to-int
                    end
                end
            else
                dup
                Core::@is_int? ! if
                    "value is not type of Color" error
                    1 exit
                end
            end
        end

    end

